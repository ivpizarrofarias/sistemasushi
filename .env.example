# Configuración de conexión a PostgreSQL.
# Copia este archivo a .env y completa los valores.
# El archivo .env NO se versiona: no subas credenciales al repositorio.

DB_URL=jdbc:postgresql://127.0.0.1:5432/NOMBRE_DE_LA_BASE
DB_USER=TU_USUARIO
DB_PASSWORD=TU_CONTRASENA

# Usuarios iniciales (opcional; solo se crean si la tabla de usuarios está vacía).
# Descomenta y define valores seguros. No hay credenciales por defecto en el código.
# SEED_ADMIN_USERNAME=
# SEED_ADMIN_PASSWORD=
# SEED_CASHIER_USERNAME=
# SEED_CASHIER_PASSWORD=

# Puerto público de la app en el servidor (el contenedor usa network_mode: host)
APP_PORT=8000

# Opcionales
# JPA_DDL_AUTO=update
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
