# Base de datos del servidor (<IP_DEL_SERVIDOR>)
# Copia este archivo a .env y redefine los valores si es necesario.
# La contraseña es obligatoria: no commitees el archivo .env.

DB_URL=jdbc:postgresql://<host>:<puerto>/<nombre_de_la_base>
DB_USER=<usuario>
DB_PASSWORD=tu-contraseña-aquí

# Puerto público de la app en el servidor (el contenedor usa network_mode: host)
APP_PORT=8000

# Opcionales
# JPA_DDL_AUTO=update
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
